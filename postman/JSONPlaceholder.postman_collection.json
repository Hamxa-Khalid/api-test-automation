{
	"info": {
		"_postman_id": "b7c3f2a1-9d4e-4c6a-8f2b-1e5d6a7c9b01",
		"name": "JSONPlaceholder API Tests",
		"description": "End-to-end API test collection for the JSONPlaceholder public API (https://jsonplaceholder.typicode.com).\n\nCovers full CRUD on /posts, a schema-style validation on /users, status-code assertions, response-body validation, and request chaining via collection variables.\n\nNote: JSONPlaceholder fakes write operations (POST/PUT/PATCH/DELETE) but returns realistic responses and status codes, which is exactly what we assert against here.\n\nAuthor: Muhammad Hamza Khalid",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Posts (CRUD)",
			"description": "Full Create-Read-Update-Delete lifecycle for the /posts resource, with request chaining through the {{postId}} collection variable.",
			"item": [
				{
					"name": "GET All Posts",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Content-Type is application/json', function () {",
									"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
									"});",
									"",
									"pm.test('Response body is a non-empty array', function () {",
									"    const body = pm.response.json();",
									"    pm.expect(body).to.be.an('array');",
									"    pm.expect(body.length).to.be.above(0);",
									"});",
									"",
									"pm.test('Each post has the expected shape', function () {",
									"    const firstPost = pm.response.json()[0];",
									"    pm.expect(firstPost).to.have.property('userId');",
									"    pm.expect(firstPost).to.have.property('id');",
									"    pm.expect(firstPost).to.have.property('title');",
									"    pm.expect(firstPost).to.have.property('body');",
									"});",
									"",
									"pm.test('Response time is under 2000ms', function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/posts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts"
							]
						},
						"description": "Retrieve the full list of posts. Asserts 200, JSON content type, and array shape."
					},
					"response": []
				},
				{
					"name": "GET Single Post",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Returned post has id 1', function () {",
									"    const post = pm.response.json();",
									"    pm.expect(post).to.be.an('object');",
									"    pm.expect(post.id).to.eql(1);",
									"});",
									"",
									"pm.test('Post has non-empty title and body', function () {",
									"    const post = pm.response.json();",
									"    pm.expect(post.title).to.be.a('string').and.to.have.length.above(0);",
									"    pm.expect(post.body).to.be.a('string').and.to.have.length.above(0);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/posts/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts",
								"1"
							]
						},
						"description": "Retrieve a single post by id. Asserts 200 and the returned id."
					},
					"response": []
				},
				{
					"name": "POST Create Post",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Pre-request example: generate a unique title so each run is traceable.",
									"pm.collectionVariables.set('runTitle', 'Automated test post ' + Date.now());"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201 (Created)', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response echoes the request body', function () {",
									"    const created = pm.response.json();",
									"    pm.expect(created.title).to.eql(pm.collectionVariables.get('runTitle'));",
									"    pm.expect(created.body).to.eql('Created by Newman/Postman automation.');",
									"    pm.expect(created.userId).to.eql(1);",
									"});",
									"",
									"pm.test('Response contains a generated id', function () {",
									"    const created = pm.response.json();",
									"    pm.expect(created).to.have.property('id');",
									"    pm.expect(created.id).to.be.a('number');",
									"});",
									"",
									"// Chain the generated id into the next requests via a collection variable.",
									"const created = pm.response.json();",
									"pm.collectionVariables.set('postId', created.id);",
									"console.log('Captured postId =', pm.collectionVariables.get('postId'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"{{runTitle}}\",\n    \"body\": \"Created by Newman/Postman automation.\",\n    \"userId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/posts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts"
							]
						},
						"description": "Create a new post. Asserts 201, echoed body, and captures the generated id into {{postId}} for chaining."
					},
					"response": []
				},
				{
					"name": "PUT Update Post",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Post reflects the full replacement', function () {",
									"    const updated = pm.response.json();",
									"    pm.expect(updated.title).to.eql('Updated title via PUT');",
									"    pm.expect(updated.body).to.eql('Fully replaced body.');",
									"    pm.expect(updated.userId).to.eql(1);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": 1,\n    \"title\": \"Updated title via PUT\",\n    \"body\": \"Fully replaced body.\",\n    \"userId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/posts/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts",
								"1"
							]
						},
						"description": "Full replacement of a post via PUT. Asserts 200 and the replaced fields."
					},
					"response": []
				},
				{
					"name": "PATCH Post",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Only the patched field changed', function () {",
									"    const patched = pm.response.json();",
									"    pm.expect(patched.title).to.eql('Partially updated title via PATCH');",
									"    // Original body for post 1 is preserved by the API.",
									"    pm.expect(patched).to.have.property('body');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Partially updated title via PATCH\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/posts/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts",
								"1"
							]
						},
						"description": "Partial update of a post via PATCH. Asserts 200 and the patched field."
					},
					"response": []
				},
				{
					"name": "DELETE Post",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response body is empty object', function () {",
									"    // JSONPlaceholder returns {} for a successful delete.",
									"    pm.expect(pm.response.json()).to.be.an('object');",
									"    pm.expect(Object.keys(pm.response.json())).to.have.lengthOf(0);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/posts/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts",
								"1"
							]
						},
						"description": "Delete a post. Asserts 200 and an empty response body."
					},
					"response": []
				}
			]
		},
		{
			"name": "Users",
			"description": "Read and schema-style validation for the /users resource.",
			"item": [
				{
					"name": "GET All Users",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response is an array of 10 users', function () {",
									"    const users = pm.response.json();",
									"    pm.expect(users).to.be.an('array');",
									"    pm.expect(users).to.have.lengthOf(10);",
									"});",
									"",
									"pm.test('First user matches the expected schema-ish shape', function () {",
									"    const user = pm.response.json()[0];",
									"    pm.expect(user).to.have.property('id').that.is.a('number');",
									"    pm.expect(user).to.have.property('name').that.is.a('string');",
									"    pm.expect(user).to.have.property('username').that.is.a('string');",
									"    pm.expect(user).to.have.property('email').that.is.a('string');",
									"    pm.expect(user).to.have.property('address').that.is.an('object');",
									"    pm.expect(user.address).to.have.property('city').that.is.a('string');",
									"    pm.expect(user).to.have.property('company').that.is.an('object');",
									"});",
									"",
									"pm.test('Every user email looks like an email', function () {",
									"    const users = pm.response.json();",
									"    users.forEach(function (u) {",
									"        pm.expect(u.email).to.match(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/);",
									"    });",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users"
							]
						},
						"description": "Retrieve all users. Asserts 200, count, per-field types, and email format."
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Collection-level pre-request: ensure baseUrl is set even without an environment.",
					"if (!pm.variables.get('baseUrl')) {",
					"    pm.collectionVariables.set('baseUrl', 'https://jsonplaceholder.typicode.com');",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://jsonplaceholder.typicode.com",
			"type": "string"
		},
		{
			"key": "postId",
			"value": "",
			"type": "string"
		},
		{
			"key": "runTitle",
			"value": "",
			"type": "string"
		}
	]
}
